# ── Gemini AI ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Get from: https://aistudio.google.com/app/apikey

# ── Locus Payments ─────────────────────────────────────────
LOCUS_API_KEY=your_locus_api_key_here
LOCUS_WALLET_ID=your_locus_wallet_id_here
LOCUS_BASE_URL=https://api.paywithlocus.com
# Get from: https://beta.paywithlocus.com (use code BETA-ACCESS-DOCS)

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ── Server ─────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── Reward amounts in USDC ─────────────────────────────────
REWARD_EASY=0.10
REWARD_MEDIUM=0.25
REWARD_HARD=0.50
MAX_DAILY_PER_STUDENT=1.00
MAX_DAILY_TOTAL=10.00
